# ─────────────────────────────────────────────────────────────────
# Weather App — Environment Variables Template
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in any values marked as required.
# All variables exposed to the browser MUST be prefixed with VITE_
# ─────────────────────────────────────────────────────────────────

# Open-Meteo (weather + geocoding + air quality) is completely free
# and requires NO API key — no variable needed.
# https://open-meteo.com/en/docs

# App display name (optional)
VITE_APP_NAME=WeatherWise

# Default city shown before the user searches (optional)
VITE_DEFAULT_CITY=Ranchi
